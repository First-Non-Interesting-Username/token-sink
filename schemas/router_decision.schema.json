{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hermesagentv3010/token-sink/schemas/router_decision.schema.json",
  "title": "Router decision",
  "description": "A single router worker's model selection for a task (PLAN \u00a77).",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "decision_uuid",
    "task_uuid",
    "router_agent_uuid",
    "selected_models",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "router_decision"
    },
    "decision_uuid": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "task_uuid": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "router_agent_uuid": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "selected_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string"
          },
          "provider_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "model_id",
          "provider_id",
          "rank"
        ],
        "additionalProperties": false
      }
    },
    "merge_policy": {
      "enum": [
        "best_single",
        "union_dedupe",
        "quorum"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "decided_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}
